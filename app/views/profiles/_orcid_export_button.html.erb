<% if a.exportable_to_orcid? %>
  <% if a.orcid_resource_identifier.present? %>
    <sup>*</sup>This information has been added to your ORCID record.
  <% else %>
    <%= button_to "Add to my ORCID Record", orcid_works_path, class: 'btn orcid-button',
                  remote: false, params: { authorship_id: a.id } %>
  <% end %>
<% else %>
  <sup>*</sup>This information cannot be added to ORCID.
<% end %>
